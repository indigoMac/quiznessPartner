# Copy to .env and fill in local values.
# Railway sets these in the service dashboard for production.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local Docker Postgres. On Railway, set DATABASE_URL to the Neon
# direct (non-pooled) connection string.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/quizness

OPENAI_API_KEY=

# JSON list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Preview deployments on Vercel are also allowed by default.
# BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
