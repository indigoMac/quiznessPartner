# Copy to .env and fill in local values.
# Railway sets these in the service dashboard for production.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local Docker Postgres. On Railway, set DATABASE_URL to the Neon
# direct (non-pooled) connection string.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/quizness

OPENAI_API_KEY=

# Quiz generation uses Groq by default (free tier, OpenAI-compatible).
# Create a key at https://console.groq.com/keys
# Without GROQ_API_KEY the code falls back to OPENAI_API_KEY while still
# pointing at LLM_BASE_URL, so an OpenAI key here would be sent to Groq
# and rejected. Set the key that matches the base URL.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Episode speech. Uses the Groq key and base URL above unless overridden.
# Host A and Host B are two Orpheus voices.
# SPEECH_MODEL=canopylabs/orpheus-v1-english
# SPEECH_VOICE_HOST_A=autumn
# SPEECH_VOICE_HOST_B=austin
#
# Audio files. auto uses the bucket when the three S3 values below are set,
# and a local directory otherwise. Set EPISODE_STORAGE=local to force the
# directory, including in tests.
# EPISODE_STORAGE=auto
# EPISODE_MEDIA_DIR=var/episode-media
#
# Cloudflare R2 is S3-compatible. Create an R2 bucket and an API token, then
# set these on Railway. The endpoint looks like
# https://<account-id>.r2.cloudflarestorage.com
# EPISODE_S3_BUCKET=
# EPISODE_S3_ACCESS_KEY_ID=
# EPISODE_S3_SECRET_ACCESS_KEY=
# EPISODE_S3_ENDPOINT_URL=
# EPISODE_S3_REGION=auto

# Retrieval over uploaded material. Off by default because indexing calls a
# paid embeddings API on every upload. Groq serves no embeddings endpoint,
# so this is configured separately and defaults to OpenAI.
# Requires PostgreSQL with pgvector (the docker-compose image provides it).
RETRIEVAL_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# JSON list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Preview deployments on Vercel are also allowed by default.
# BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
